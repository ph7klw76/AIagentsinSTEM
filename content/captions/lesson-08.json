    "end": 260.87666666666667,
    "text": "Quantum calculations and charge fitting are\nseparate steps.",
    "origin": "AI_Bilayer_Diagnostics_Professional.srt"
  },
  {
    "start": 261.13666666666666,
    "end": 263.5176666666667,
    "text": "The useful workflow connects these stages",
