[
  {
    "start": 0.3996666666666556,
    "end": 4.241666666666656,
    "text": "Before trusting a simulation, test its\nnumerical behavior.",
    "origin": "AI_Bilayer_Diagnostics_Professional.srt"
  },
  {
    "start": 4.7226666666666555,
    "end": 7.984666666666656,
    "text": "This case follows an AI-assisted investigation",
    "origin": "AI_Bilayer_Diagnostics_Professional.srt"
  },
  {
    "start": 7.984666666666656,
    "end": 12.226666666666656,
    "text": "of a beta-DDM bilayer at seventy-five degrees\nCelsius.",
    "origin": "AI_Bilayer_Diagnostics_Professional.srt"
  },
  {
    "start": 12.646666666666656,
    "end": 15.808666666666655,
    "text": "The original phase diagram marks a lamellar\ntarget",
    "origin": "AI_Bilayer_Diagnostics_Professional.srt"
  },
  {
    "start": 15.808666666666655,
    "end": 17.569666666666656,
    "text": "at twenty percent water by mass.",
    "origin": "AI_Bilayer_Diagnostics_Professional.srt"
  },
  {
    "start": 17.969666666666654,
    "end": 19.710666666666654,
    "text": "That reference guides the question;",
    "origin": "AI_Bilayer_Diagnostics_Professional.srt"
  },
  {
    "start": 20.030666666666654,
    "end": 22.592666666666656,
    "text": "the simulation must still establish its\nbehavior.",
    "origin": "AI_Bilayer_Diagnostics_Professional.srt"
  },
  {
    "start": 23.752666666666656,
    "end": 25.773666666666657,
    "text": "The molecular view raises the question",
    "origin": "AI_Bilayer_Diagnostics_Professional.srt"
  },
  {
    "start": 25.773666666666657,
    "end": 27.453666666666656,
    "text": "of water inside the membrane.",
    "origin": "AI_Bilayer_Diagnostics_Professional.srt"
  },
  {
    "start": 28.273666666666657,
    "end": 30.674666666666656,
    "text": "In the separate single-snapshot analysis,",
    "origin": "AI_Bilayer_Diagnostics_Professional.srt"
  },
  {
    "start": 30.954666666666654,
